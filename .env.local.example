# ─────────────────────────────────────────────────────────────────────
# Salamarket Drive — variables d'environnement (exemple)
#
# Copie ce fichier en `.env.local` (gitignored) et complète les valeurs.
# Les variables `VITE_*` sont exposées au bundle client.
# ─────────────────────────────────────────────────────────────────────

# Supabase (déjà présent dans .env)
VITE_SUPABASE_PROJECT_ID="tltmermqodelorthtbre"
VITE_SUPABASE_URL="https://tltmermqodelorthtbre.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="anon-key-here"

# ─────── Drive au poids — Stripe manual capture ─────────────────────
#
# Clef publishable Stripe (mode test : pk_test_…, mode live : pk_live_…)
# Côté backend (API routes) c'est la clé secrète qui crée l'intent ;
# côté client on n'a besoin que de la publishable pour Elements.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_PLACEHOLDER"

# Base URL des API routes Stripe (créées côté salam-stock).
# - Dev local : http://localhost:3000
# - Preview / prod : https://salam-stock.vercel.app
VITE_STRIPE_API_BASE_URL="http://localhost:3000"
