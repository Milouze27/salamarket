# Stripe TEST MODE — copier dans .env.local et remplir
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER

# ─── Secrets internes (hardening sécurité) ────────────────────────────
# Token partagé entre routes API internes (email/send, assistant) et
# leurs callers internes (server actions, crons, po/send, casse digest).
# REQUIS pour bloquer le relais spam anonyme et le burn de quota Claude.
# Génère avec : openssl rand -hex 32
INTERNAL_API_SECRET=

# Token Vercel Cron — auto-injecté par Vercel sur les routes cron en prod.
# REQUIS sur tous les /api/cron/* : si manquant, les routes renvoient 503
# (refus de servir pour éviter qu'un cron sensible soit appelé par n'importe
# qui sur un déploiement mal configuré).
CRON_SECRET=
