# ─── Supabase ───────────────────────────────────────────────────
# Project: tltmermqodelorthtbre  (https://tltmermqodelorthtbre.supabase.co)
# Get the keys from Supabase Dashboard → Project Settings → API.
# When NEXT_PUBLIC_SUPABASE_URL is unset, the app runs in local-seed
# mode (JSON files) for dev / demo without backend.
NEXT_PUBLIC_SUPABASE_URL=https://tltmermqodelorthtbre.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (used by API routes that need RLS bypass for admin actions).
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic (Claude vision for sortie coherence check) ─────
# When unset, sortie writes a deterministic mock score so the app stays
# usable. Set a real key to activate vision-based coherence scoring.
ANTHROPIC_API_KEY=

# ─── Notifications (optionnel) ────────────────────────────────
# Webhook (Make / Zapier / n8n) qui envoie le payload JSON à Otmane
# sur WhatsApp. Si vide, les notifs sont juste loggées console.
WHATSAPP_WEBHOOK_URL=
